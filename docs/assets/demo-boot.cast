[2.09, "o", "\u001b[2m# unlock a virtual TCG Opal SED, then chainload a REAL Linux kernel\u001b[0m\r\n"]
[2.99, "o", "\u001b[96mMOCKOPAL: protocol installed\u001b[0m\r\n"]
[3.14, "o", "\u001b[96mMOCKOPAL: nvme passthru installed\u001b[0m\r\n"]
[3.39, "o", "\u001b[92mTRUSTED-PBA: start\u001b[0m\r\n"]
[3.59, "o", "\u001b[2mTRUSTED-PBA: version 1355f00\u001b[0m\r\n"]
[3.71, "o", "\u001b[92mTRUSTED-PBA: secure-boot: off\u001b[0m\r\n"]
[4.01, "o", "\u001b[96mMOCKOPAL: startsession 1\u001b[0m\r\n"]
[4.19, "o", "\u001b[96mMOCKOPAL: auth ok\u001b[0m\r\n"]
[4.37, "o", "\u001b[96mMOCKOPAL: unlocked\u001b[0m\r\n"]
[4.55, "o", "\u001b[96mMOCKOPAL: mbr-done set\u001b[0m\r\n"]
[4.73, "o", "\u001b[2mMOCKOPAL: session end\u001b[0m\r\n"]
[4.88, "o", "\u001b[92m\u001b[1mTRUSTED-PBA: sed unlock ok\u001b[0m\r\n"]
[5.33, "o", "\u001b[92mTRUSTED-PBA: target \"linux\" (EFI/TEST/TESTAPP.EFI) via firmware\u001b[0m\r\n"]
[5.53, "o", "\u001b[92mTRUSTED-PBA: ESP opened\u001b[0m\r\n"]
[5.68, "o", "\u001b[92mTRUSTED-PBA: starting EFI/TEST/TESTAPP.EFI\u001b[0m\r\n"]
[6.18, "o", "\u001b[2m[    0.000000] Linux version 7.1.6-201.fc44.x86_64  #1 SMP PREEMPT_DYNAMIC\u001b[0m\r\n"]
[6.48, "o", "\u001b[2m[    0.305482] kfence: initialized\u001b[0m\r\n"]
[6.58, "o", "\u001b[2m[    1.636918] pci 0000:00:02.0: BAR 0 [io  0x6000-0x607f]\u001b[0m\r\n"]
[6.68, "o", "\u001b[2m[    2.691851] Loading compiled-in X.509 certificates\u001b[0m\r\n"]
[6.78, "o", "\u001b[2m\u001b[93m               \u2026 Linux kernel boot (trimmed for the demo) \u2026\u001b[0m\r\n"]
[7.38, "o", "\u001b[2m[    3.821895] Run /init as init process\u001b[0m\r\n"]
[7.68, "o", "\u001b[92m\u001b[1mTEST-LINUX: userspace ok\u001b[0m\r\n"]
[8.13, "o", "\u001b[2m[    5.919285] reboot: Power down\u001b[0m\r\n"]
